# Runtime
NODE_ENV=production
PORT=3001
SESSION_SECRET=replace-with-a-long-random-secret

# Public URLs (no trailing slash)
PUBLIC_APP_URL=https://app.example.com
API_PUBLIC_URL=https://api.example.com
FRONTEND_URL=https://app.example.com

# PostgreSQL (use DATABASE_URL or the SUPABASE_* database fields)
DATABASE_URL=postgresql://user:password@host:5432/database
PGSSLMODE=require

# Email delivery (required for production account recovery and verification)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=replace-me
SMTP_PASS=replace-me
SMTP_FROM=IMSTEV NATURALS <no-reply@example.com>
EMAIL_FROM=no-reply@example.com
# Alternatively use a complete SMTP URL:
# SMTP_URL=smtps://user:password@smtp.example.com:465

# Payments (Quickteller/Interswitch live credentials)
QUICKTELLER_ENV=live
QUICKTELLER_CLIENT_ID=replace-me
QUICKTELLER_CLIENT_SECRET=replace-me
QUICKTELLER_MERCHANT_CODE=replace-me
QUICKTELLER_PAYMENT_ITEM_ID=replace-me

# Telehealth (Daily.co)
DAILY_API_KEY=replace-me

# AI analysis provider (server-side only)
OPENAI_API_KEY=replace-me
# OPENAI_BASE_URL=https://api.openai.com/v1
# AI_INTEGRATIONS_OPENAI_API_KEY=replace-me
# AI_INTEGRATIONS_OPENAI_BASE_URL=https://api.openai.com/v1

# Optional Google sign-in
GOOGLE_CLIENT_ID=replace-me

# Optional local filesystem path; use durable/private storage in production
UPLOADS_DIR=/var/lib/imstev/uploads

# Optional database aliases for Supabase-hosted PostgreSQL
# SUPABASE_URL=https://project-ref.supabase.co
# SUPABASE_DB_PASSWORD=replace-me
# SUPABASE_DB_HOST=db.project-ref.supabase.co
# SUPABASE_DB_USER=postgres
# SUPABASE_DB_NAME=postgres
# SUPABASE_DB_PORT=5432
# SUPABASE_ANON_KEY=replace-me
# SUPABASE_SERVICE_ROLE_KEY=replace-me

# Optional development-only admin fallback. Do not set these in production;
# use the admin_credentials table instead.
# ADMIN_EMAIL=
# ADMIN_PASSWORD=
