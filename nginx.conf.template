# IMSTEV NATURALS — nginx config
# Place this file at: /etc/nginx/sites-available/imstevnaturals.com
# Enable with: sudo ln -s /etc/nginx/sites-available/imstevnaturals.com /etc/nginx/sites-enabled/
# Then: sudo nginx -t && sudo systemctl reload nginx
#
# After enabling, run Certbot for HTTPS:
#   sudo certbot --nginx -d imstevnaturals.com -d www.imstevnaturals.com

# Redirect HTTP → HTTPS
server {
    listen 80;
    listen [::]:80;
    server_name imstevnaturals.com www.imstevnaturals.com;
    return 301 https://$host$request_uri;
}

# Main HTTPS server block
server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name imstevnaturals.com www.imstevnaturals.com;

    # ── SSL (managed by Certbot — do not edit manually) ───────────
    # ssl_certificate /etc/letsencrypt/live/imstevnaturals.com/fullchain.pem;
    # ssl_certificate_key /etc/letsencrypt/live/imstevnaturals.com/privkey.pem;
    # include /etc/letsencrypt/options-ssl-nginx.conf;
    # ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    # ── Security headers (helmet handles these in Express too) ─────
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    # ── Gzip ──────────────────────────────────────────────────────
    gzip on;
    gzip_types text/plain text/css application/json application/javascript text/xml application/xml image/svg+xml;
    gzip_min_length 1024;

    # ── Serve built frontend (dist/) ──────────────────────────────
    root /var/www/imstevnaturals/skin-sense-buddy-main/dist;
    index index.html;

    # Static asset caching (JS/CSS/images get long-lived cache)
    location ~* \.(js|css|png|jpg|jpeg|gif|ico|svg|woff|woff2|ttf)$ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }

    # ── Proxy /api → Express backend ─────────────────────────────
    location /api/ {
        proxy_pass http://127.0.0.1:3001;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_cache_bypass $http_upgrade;
        proxy_read_timeout 120s;
        proxy_connect_timeout 10s;
    }

    # ── Proxy /uploads → Express backend ─────────────────────────
    location /uploads/ {
        proxy_pass http://127.0.0.1:3001;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_cache_bypass $http_upgrade;
        # 10MB file upload limit (matches Express 50mb JSON limit)
        client_max_body_size 50m;
    }

    # ── SPA fallback — serve index.html for all other routes ─────
    location / {
        try_files $uri $uri/ /index.html;
    }

    # ── Block access to .env and hidden files ─────────────────────
    location ~ /\. {
        deny all;
        return 404;
    }
}
